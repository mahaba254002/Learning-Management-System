# Local development only. Replace placeholders before starting the backend.
DATABASE_URL=postgresql+psycopg://rollcall:replace-me@localhost:5432/rollcall
JWT_SECRET_KEY=replace-with-a-long-random-secret
REDIS_URL=redis://localhost:6379/0
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_BASE_URL=http://localhost:5173
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=onboarding@resend.dev

# Inbox for public product enquiries; configure privately in each environment.
PRODUCT_ENQUIRY_EMAIL=

# Subscription notices use institution official emails, never student addresses.
BILLING_SUPPORT_EMAIL=mahaba955@gmail.com

# Required in production for authenticating backup archives; preserve securely.
BACKUP_SIGNING_KEY=
# Optional absolute tool paths; otherwise discovered on the API server PATH.
PG_DUMP_PATH=
PG_RESTORE_PATH=
# Separate EMPTY PostgreSQL recovery database; never the running database.
RESTORE_DATABASE_URL=
