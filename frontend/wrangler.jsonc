{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "skynet",
  "main": "worker.js",
  "compatibility_date": "2026-09-30",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "previews": {
    "vars": {
      "API_ORIGIN": "",
      "PUBLIC_SITE_ORIGIN": "https://skynet.mahaba955.workers.dev",
      "INDEX_PUBLIC_SITE": false
    }
  },
  "vars": {
    "API_ORIGIN": "https://learning-management-system-5nws.onrender.com",
    "PUBLIC_SITE_ORIGIN": "https://skynet.mahaba955.workers.dev",
    "INDEX_PUBLIC_SITE": true
  }
}
